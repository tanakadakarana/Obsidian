properties:
  file.name:
    displayName: FILE
  note.date:
    displayName: 日
  note.flush:
    displayName: 🚀
  note.read:
    displayName: 📗
  note.kindle:
    displayName: 📖
  note.mikan:
    displayName: 🍊
  note.duo:
    displayName: 🦜
  note.study:
    displayName: ✏
  note.mindfullness:
    displayName: 🧘
  note.voicy_araki:
    displayName: 荒木
  note.podcast:
    displayName: 📻️
  note.audible:
    displayName: 👂️
  note.schoo:
    displayName: 🎦
  note.good3:
    displayName: 3GoodThings
  note.chochozap:
    displayName: 🏃
  note.weather:
    displayName: ☀
views:
  - type: table
    name: ハビットトラッカー
    filters:
      and:
        - file.name.startsWith("20")
        - or:
            - file.folder.startsWith("10_Dairy")
            - file.folder == "99.Inbox"
    order:
      - file.name
      - date
      - weather
      - score
      - word
      - good3
      - flush
      - read
      - kindle
      - mikan
      - duo
      - chochozap
      - mindfullness
      - study
      - voicy_araki
      - podcast
      - audible
      - schoo
    sort:
      - property: file.name
        direction: DESC
    limit: 20
    columnSize:
      file.name: 83
      note.date: 10
      note.weather: 76
      note.score: 106
      note.word: 245
      note.good3: 232
